/* spotMap.wxss - 景点地图页面样式 */

/* 地图容器 */
.map-container {
  position: relative;
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 地图组件 */
.map {
  width: 100%;
  height: 100%;
}

/* 顶部搜索栏 */
.search-bar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  padding: 16rpx 32rpx;
  background-color: rgba(255, 255, 255, 0.95);
  display: flex;
  align-items: center;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.search-input-container {
  flex: 1;
  position: relative;
  height: 72rpx;
  background-color: #f5f5f5;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 16rpx;
}

.search-icon {
  color: #999;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
  background: none;
}

.clear-btn {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
  color: #999;
}

.search-btn {
  width: 120rpx;
  height: 72rpx;
  font-size: 28rpx;
  line-height: 72rpx;
  padding: 0;
  background-color: #0091ff;
  color: #ffffff;
  border-radius: 36rpx;
}

.search-btn:active {
  background-color: #0077cc;
}

/* 信息窗口 */
.info-window {
  position: absolute;
  bottom: 200rpx;
  left: 32rpx;
  right: 32rpx;
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  padding: 24rpx;
  z-index: 99;
  max-height: 60vh;
  overflow-y: auto;
  animation: slideUp 0.3s ease-out;
}

@keyframes slideUp {
  from {
    transform: translateY(100rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.info-window-header {
  display: flex;
  margin-bottom: 20rpx;
}

.spot-image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
}

.spot-basic-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.spot-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.spot-rating {
  display: flex;
  align-items: baseline;
}

.rating-score {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff8800;
  margin-right: 4rpx;
}

.rating-label {
  font-size: 24rpx;
  color: #666;
}

.info-window-content {
  margin-bottom: 24rpx;
}

.info-item {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  font-size: 26rpx;
  color: #666;
}

.info-icon {
  margin-right: 12rpx;
  color: #999;
}

.info-text {
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.info-description {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.info-window-actions {
  display: flex;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  padding: 0;
}

.view-detail-btn {
  background-color: #0091ff;
  color: #ffffff;
}

.view-detail-btn:active {
  background-color: #0077cc;
}

.route-btn {
  background-color: #ff8800;
  color: #ffffff;
}

.route-btn:active {
  background-color: #e67700;
}

/* 底部控制按钮 */
.map-controls {
  position: absolute;
  bottom: 80rpx;
  right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  z-index: 98;
}

.control-btn {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  background-color: #ffffff;
}

.control-btn text {
  font-size: 24rpx;
  margin-top: 4rpx;
}

/* 加载提示 */
.loading-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.loading-content {
  background-color: #ffffff;
  padding: 40rpx 60rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.loading-icon {
  width: 80rpx;
  height: 80rpx;
  margin-bottom: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 适配不同屏幕尺寸 */
@media screen and (min-width: 768px) {
  .info-window {
    left: 50%;
    transform: translateX(-50%);
    width: 600rpx;
    max-width: 90%;
  }
}

/* 滚动条样式 */
.info-window::-webkit-scrollbar {
  width: 8rpx;
}

.info-window::-webkit-scrollbar-track {
  background: #f1f1f1;
  border-radius: 4rpx;
}

.info-window::-webkit-scrollbar-thumb {
  background: #888;
  border-radius: 4rpx;
}

.info-window::-webkit-scrollbar-thumb:hover {
  background: #555;
}