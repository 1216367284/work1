/* spotDetail.wxss - 景点详情页面样式 */

.page-container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 400px;
}

.loading-icon {
  width: 40px;
  height: 40px;
  margin-bottom: 10px;
}

.loading-text {
  font-size: 14px;
  color: #999;
}

/* 图片轮播 */
.image-carousel {
  position: relative;
  height: 250px;
}

.swiper {
  height: 100%;
}

.spot-image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-count {
  position: absolute;
  bottom: 10px;
  right: 10px;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
}

/* 基本信息 */
.spot-basic-info {
  padding: 15px;
  background-color: #fff;
  margin-bottom: 10px;
}

.spot-title-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 10px;
}

.spot-name {
  font-size: 20px;
  font-weight: bold;
  color: #333;
  flex: 1;
  margin-right: 10px;
}

.favorite-btn {
  padding: 0;
  background-color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
}

.spot-rating {
  display: flex;
  align-items: baseline;
  margin-bottom: 10px;
}

.rating-score {
  font-size: 18px;
  font-weight: bold;
  color: #ff9500;
  margin-right: 2px;
}

.rating-label {
  font-size: 12px;
  color: #ff9500;
  margin-right: 5px;
}

.review-count {
  font-size: 12px;
  color: #999;
}

.spot-price {
  font-size: 16px;
  font-weight: bold;
  color: #e64340;
  margin-bottom: 10px;
}

.spot-address {
  display: flex;
  align-items: center;
}

.address-icon {
  color: #666;
  margin-right: 5px;
}

.address-text {
  flex: 1;
  font-size: 14px;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.navigate-btn {
  padding: 4px 12px;
  font-size: 13px;
  background-color: #1aad19;
  color: #fff;
  border-radius: 15px;
}

/* 标签页 */
.tabs {
  display: flex;
  background-color: #fff;
  margin-bottom: 10px;
  border-bottom: 1px solid #eee;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 15px 0;
  font-size: 15px;
  color: #666;
  position: relative;
}

.tab.active {
  color: #1aad19;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 20px;
  height: 3px;
  background-color: #1aad19;
  border-radius: 1.5px;
}

/* 内容区域 */
.tab-content {
  background-color: #fff;
  padding-bottom: 60px;
  min-height: 300px;
}

/* 概览内容 */
.section {
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.section-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
  margin-bottom: 10px;
}

.section-content {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  white-space: pre-wrap;
}

.features-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.feature-tag {
  background-color: #f5f5f5;
  color: #666;
  padding: 6px 12px;
  border-radius: 15px;
  font-size: 13px;
}

/* 活动列表 */
.activities-list {
  display: flex;
  overflow-x: auto;
  padding-right: 15px;
}

.activity-item {
  width: 150px;
  margin-right: 10px;
  flex-shrink: 0;
}

.activity-image {
  width: 100%;
  height: 100px;
  border-radius: 6px;
  margin-bottom: 8px;
}

.activity-info {
  display: flex;
  flex-direction: column;
}

.activity-name {
  font-size: 14px;
  color: #333;
  margin-bottom: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.activity-time {
  font-size: 12px;
  color: #999;
}

/* 点评列表 */
.review-item {
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.review-header {
  display: flex;
  align-items: center;
  margin-bottom: 10px;
}

.user-avatar {
  width: 40px;
  height: 40px;
  border-radius: 20px;
  margin-right: 10px;
}

.review-user-info {
  flex: 1;
}

.user-name {
  font-size: 14px;
  font-weight: bold;
  color: #333;
  margin-bottom: 2px;
}

.review-time {
  font-size: 12px;
  color: #999;
}

.review-rating {
  display: flex;
  align-items: baseline;
}

.rating-value {
  font-size: 16px;
  font-weight: bold;
  color: #ff9500;
  margin-right: 2px;
}

.rating-unit {
  font-size: 12px;
  color: #ff9500;
}

.review-content {
  font-size: 14px;
  color: #666;
  line-height: 1.6;
  margin-bottom: 10px;
  white-space: pre-wrap;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.review-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
}

.load-more, .empty-reviews {
  padding: 15px;
  text-align: center;
  font-size: 14px;
  color: #999;
}

/* 附近景点 */
.nearby-item {
  display: flex;
  padding: 15px;
  border-bottom: 1px solid #f0f0f0;
}

.nearby-image {
  width: 80px;
  height: 80px;
  border-radius: 6px;
  margin-right: 12px;
}

.nearby-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.nearby-name {
  font-size: 15px;
  color: #333;
  margin-bottom: 5px;
}

.nearby-rating {
  font-size: 14px;
  color: #ff9500;
  margin-bottom: 5px;
}

.nearby-distance {
  font-size: 13px;
  color: #999;
}

.empty-nearby {
  padding: 60px 15px;
  text-align: center;
  font-size: 14px;
  color: #999;
}

/* 底部操作栏 */
.bottom-action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  padding: 10px 15px;
  border-top: 1px solid #eee;
  z-index: 100;
}

.contact-btn {
  flex: 1;
  margin-right: 10px;
  background-color: #fff;
  color: #666;
  border: 1px solid #ddd;
  font-size: 15px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-btn icon {
  margin-right: 5px;
}

.book-btn {
  flex: 2;
  background-color: #e64340;
  color: #fff;
  font-size: 15px;
}

/* 地图弹窗 */
.map-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.map-modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
}

.map-modal-content {
  background-color: #fff;
  border-top-left-radius: 15px;
  border-top-right-radius: 15px;
  position: relative;
  z-index: 1;
  padding-bottom: env(safe-area-inset-bottom);
}

.map-modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15px;
  border-bottom: 1px solid #eee;
}

.map-modal-title {
  font-size: 16px;
  font-weight: bold;
  color: #333;
}

.close-btn {
  color: #999;
}

.map-container {
  height: 300px;
  border-bottom: 1px solid #eee;
}

.open-map-btn {
  margin: 15px;
  background-color: #1aad19;
  color: #fff;
  font-size: 15px;
}

/* 响应式样式调整 */
@media screen and (min-width: 768px) {
  .page-container {
    max-width: 768px;
    margin: 0 auto;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
  }
  
  .bottom-action-bar {
    max-width: 768px;
    margin: 0 auto;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
  }
}